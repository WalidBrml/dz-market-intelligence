	partition v_inventory_risk = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "v_inventory_risk.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
