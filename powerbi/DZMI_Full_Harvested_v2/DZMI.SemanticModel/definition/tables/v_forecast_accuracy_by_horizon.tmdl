/// SQL pooled accuracy per run x model x basis x level x horizon bucket (dwh.v_forecast_accuracy_by_horizon). Reconciliation only.
table v_forecast_accuracy_by_horizon
	lineageTag: 579bfba4-463d-51a0-9e8f-eaf8566411e7

	column backtest_run_id
		dataType: string
		isHidden
		lineageTag: 0cb609ac-71be-57cd-9cce-cc116f7dbcf9
		summarizeBy: none
		sourceColumn: backtest_run_id

	column model_name
		dataType: string
		isHidden
		lineageTag: 3a2a4018-9875-5e90-91b3-8e551739b7e8
		summarizeBy: none
		sourceColumn: model_name

	column evaluation_basis
		dataType: string
		isHidden
		lineageTag: 95e81bf0-a569-5b68-bc37-cb8c0ee4d7be
		summarizeBy: none
		sourceColumn: evaluation_basis

	column level
		dataType: string
		isHidden
		lineageTag: 2d1c9e5c-c866-59d1-9486-cd5a3d4a60c4
		summarizeBy: none
		sourceColumn: level

	column horizon_bucket
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 21de9797-3105-5b9c-99e8-163c47551417
		summarizeBy: none
		sourceColumn: horizon_bucket

	column n_origins
		dataType: int64
		formatString: 0
