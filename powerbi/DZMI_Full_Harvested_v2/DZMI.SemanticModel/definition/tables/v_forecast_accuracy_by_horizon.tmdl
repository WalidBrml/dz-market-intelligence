	column horizon_key
		dataType: string
		isHidden
		lineageTag: 645a9bd0-579f-57c7-9249-3013420268b4
		summarizeBy: none
		sourceColumn: horizon_key

	partition v_forecast_accuracy_by_horizon = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "v_forecast_accuracy_by_horizon.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"backtest_run_id", type text},
				            {"model_name", type text},
				            {"evaluation_basis", type text},
				            {"level", type text},
				            {"horizon_bucket", Int64.Type},
				            {"n_origins", Int64.Type},
				            {"n_obs", Int64.Type},
				            {"sum_actual", type number},
				            {"sum_pred", type number},
				            {"sum_abs_error", type number},
				            {"sum_sq_error", type number},
				            {"mae", type number},
				            {"mse", type number},
				            {"wape", type number},
				            {"bias", type number},
				            {"skill_mae_vs_seasonal_naive", type number}
				        },
				        "en-US"
				    ),
				    Added_horizon_key = Table.AddColumn(Typed, "horizon_key", each [level] & "|" & Text.From([horizon_bucket]), type text)
				in
				    Added_horizon_key

