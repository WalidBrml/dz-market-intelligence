		formatString: #,0.00
		lineageTag: 6caa5885-77c8-5f70-aa9a-e19ea247b0c1
		summarizeBy: none
		sourceColumn: sum_abs_error

	column sum_sq_error
		dataType: double
		formatString: #,0.00
		lineageTag: 4f5836b6-c7cb-5b85-acb1-a6f1232105e0
		summarizeBy: none
		sourceColumn: sum_sq_error

	column mae
		dataType: double
		formatString: #,0.00
		lineageTag: 6d7afa3f-891d-588f-8d9e-29e537a6e440
		summarizeBy: none
		sourceColumn: mae

	column mse
		dataType: double
		formatString: #,0.00
		lineageTag: 9105b50a-549f-522f-917d-4e20423a8774
		summarizeBy: none
		sourceColumn: mse

	column wape
		dataType: double
		formatString: #,0.00
		lineageTag: 3cd45f11-ba25-567c-861f-73f5d4b04785
		summarizeBy: none
		sourceColumn: wape

	column bias
		dataType: double
		formatString: #,0.00
		lineageTag: cbc0032a-b3e6-5a3f-b564-986ffe980994
