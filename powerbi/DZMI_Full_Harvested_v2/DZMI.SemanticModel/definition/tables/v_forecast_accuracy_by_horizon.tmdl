		summarizeBy: none
		sourceColumn: sum_actual

	column sum_pred
		dataType: double
		formatString: #,0.00
		lineageTag: c289b3c8-d05c-537f-be72-0e5ccaa971a7
		summarizeBy: none
		sourceColumn: sum_pred

	column sum_abs_error
