	partition dim_store = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "dim_store.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"store_key", Int64.Type},
				            {"store_id", Int64.Type},
				            {"store_code", type text},
				            {"store_name", type text},
				            {"wilaya", type text},
				            {"city", type text},
				            {"store_format", type text},
				            {"floor_area_sqm", Int64.Type},
				            {"opened_date", type date}
				        },
				        "en-US"
				    )
				in
				    Typed

