	column week_part
		dataType: string
		lineageTag: a3cc64b4-842d-5e1d-b74c-202492619112
		summarizeBy: none
		sourceColumn: week_part

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"date_key", Int64.Type},
				            {"full_date", type date},
				            {"year", Int64.Type},
				            {"quarter", Int64.Type},
				            {"month", Int64.Type},
				            {"month_name", type text},
				            {"day_of_month", Int64.Type},
				            {"day_of_week", Int64.Type},
				            {"day_name", type text},
				            {"iso_week", Int64.Type},
				            {"is_weekend", Int64.Type},
				            {"is_ramadan", Int64.Type},
				            {"ramadan_day", Int64.Type},
				            {"is_eid_al_fitr", Int64.Type},
				            {"is_eid_al_adha", Int64.Type},
				            {"is_pre_eid_al_fitr", Int64.Type},
				            {"is_pre_eid_al_adha", Int64.Type},
				            {"year_month", Int64.Type},
				            {"year_month_label", type text},
				            {"year_quarter_label", type text},
				            {"days_in_month", Int64.Type},
				            {"is_complete_month", Int64.Type},
				            {"prior_year_date_key", Int64.Type},
				            {"day_seq", Int64.Type},
				            {"is_last_loaded_date", Int64.Type}
				        },
				        "en-US"
				    ),
				    Added_calendar_period = Table.AddColumn(Typed, "calendar_period", each if [is_eid_al_fitr] = 1 then "Eid al-Fitr" else if [is_eid_al_adha] = 1 then "Eid al-Adha" else if [is_ramadan] = 1 then "Ramadan" else "Regular days", type text),
				    Added_week_part = Table.AddColumn(Added_calendar_period, "week_part", each if [is_weekend] = 1 then "Weekend (Fri-Sat)" else "Weekday", type text)
				in
				    Added_week_part

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

