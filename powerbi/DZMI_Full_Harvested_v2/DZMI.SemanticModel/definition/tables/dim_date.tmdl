/// Calendar (dwh.v_dim_date_bi): one row per loaded day. Marked as the date table on full_date.
table dim_date
	lineageTag: 3200a16a-9c76-5a08-a00f-6c357e5b4200
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6ec9f1ed-519d-5bae-aa55-fc5b9b72eed4
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: a3153ca6-ee96-5f08-8e48-820092482cd3
		summarizeBy: none
		sourceColumn: full_date

		annotation UnderlyingDateTimeDataType = Date

	column year
