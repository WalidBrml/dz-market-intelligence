/// Aggregation levels at which errors are measured.
table dim_eval_level
	lineageTag: 8de2d1e3-7b7b-5652-8fe5-95453bbf2cc8

	column level
		dataType: string
		isHidden
		lineageTag: 4b98e934-ca2d-5a2f-b04e-a1f65e2dd1a5
		summarizeBy: none
		sourceColumn: level

	column level_label
		dataType: string
		lineageTag: 6a408466-3beb-5eb8-be1d-0b3ed46924ca
		summarizeBy: none
		sourceColumn: level_label
		sortByColumn: level_order

	column level_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 930451a4-e3df-5faf-b892-90f15296c01f
		summarizeBy: none
		sourceColumn: level_order

	column horizon_unit
		dataType: string
		lineageTag: 53f018b9-327a-5c47-9463-20a8b24767ee
		summarizeBy: none
		sourceColumn: horizon_unit

	partition dim_eval_level = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "forecast_backtest_metric.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Distinct = Table.Distinct(Table.SelectColumns(Promoted, {"level"})),
				    Meta = [
				        series_day = {"Series x day", 1, "Day"},
				        store_category_week = {"Store x category x week", 2, "Week"}
				    ],
				    Lookup = (key as text, idx as number, fallback as any) as any =>
				        let m = Record.FieldOrDefault(Meta, key, null) in if m = null then fallback else m{idx},
				    Labelled = Table.AddColumn(Distinct, "level_label", each Lookup([level], 0, [level]), type text),
				    Seq = Table.AddColumn(Labelled, "level_order", each Lookup([level], 1, 99), Int64.Type),
				    Unit = Table.AddColumn(Seq, "horizon_unit", each Lookup([level], 2, "Step"), type text),
				    Ordered = Table.ReorderColumns(Unit, {"level", "level_label", "level_order", "horizon_unit"})
				in
				    Ordered

